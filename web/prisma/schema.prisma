generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A CTFtime team. Created on first login, or by an admin to pre-ban a team.
model Team {
  id           Int       @id // CTFtime team id
  name         String
  contactEmail String?
  requested    Int       @default(0)
  // Set when the team submits the form for the first time. Teams registered
  // after the freeze are "late" and appended to every round.
  registeredAt DateTime?
  // Request at the freeze, lowered along with `requested`. Only vouchers up
  // to this keep the team's shuffled place.
  frozenRequested Int?
  // Requests after the freeze, `[{ at, upTo }]` in time order (see
  // lib/order.ts). Each one's vouchers queue at the back of every round.
  raises       Json      @default("[]")
  banned       Boolean   @default(false)
  banReason    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignments Assignment[]
}

// Singleton row (id = 1) holding the distribution state.
model State {
  id            Int       @id @default(1)
  frozenAt      DateTime?
  frozenTeamIds Int[]
  seed          String?
  // While set, no vouchers are assigned and no voucher mails are sent.
  // Admin alerts still go out.
  pausedAt      DateTime?
}

enum VoucherSource {
  SEED
  REPLICATED
  MANUAL
}

model Voucher {
  id         String        @id @default(cuid())
  code       String        @unique
  source     VoucherSource
  // Held vouchers are not distributed until an admin releases them.
  held       Boolean       @default(false)
  heldReason String?
  createdAt  DateTime      @default(now())

  // The assignment whose replication address this voucher arrived at.
  parentAssignmentId String?
  parentAssignment   Assignment?  @relation("Replicas", fields: [parentAssignmentId], references: [id])
  inboundMailId      String?
  inboundMail        InboundMail? @relation(fields: [inboundMailId], references: [id])

  assignments Assignment[] @relation("VoucherAssignments")
}

// A voucher handed to a team. Replicas arrive at v-<token>@, confirmations at c-<token>@.
model Assignment {
  id        String   @id @default(cuid())
  token     String   @unique
  round     Int
  createdAt DateTime @default(now())

  voucherId String
  voucher   Voucher @relation("VoucherAssignments", fields: [voucherId], references: [id])
  teamId    Int
  team      Team    @relation(fields: [teamId], references: [id])

  sentAt               DateTime?
  confirmedAt          DateTime?
  confirmNote          String?
  replicatedAt         DateTime?
  unconfirmedFlaggedAt DateTime?
  overdueFlaggedAt     DateTime?
  // Set by "clear flags": the flag timers restart from here.
  flagsClearedAt       DateTime?
  revokedAt            DateTime?
  revokeReason         String?
  // A refunded revocation no longer counts towards the team's voucher count.
  slotRefunded         Boolean   @default(false)

  replicas Voucher[]      @relation("Replicas")
  outbound OutboundMail[]

  @@index([teamId])
  @@index([voucherId])
}

enum InboundStatus {
  PROCESSED
  UNMATCHED
  NO_CODE
  HELD
  IGNORED
  REJECTED
}

model InboundMail {
  id         String        @id @default(cuid())
  messageId  String        @unique
  recipient  String
  sender     String
  from       String
  subject    String
  bodyPlain  String
  headers    Json
  status     InboundStatus
  note       String?
  receivedAt DateTime      @default(now())

  vouchers Voucher[]
}

enum OutboundKind {
  VOUCHER
  ADMIN_ALERT
}

enum OutboundStatus {
  PENDING
  SENDING
  SENT
  FAILED
  // The assignment was revoked before the mail went out.
  CANCELLED
}

model OutboundMail {
  id        String         @id @default(cuid())
  kind      OutboundKind
  to        String
  replyTo   String?
  subject   String
  text      String
  status    OutboundStatus @default(PENDING)
  attempts  Int            @default(0)
  lastError String?
  mailgunId String?
  createdAt DateTime       @default(now())
  claimedAt DateTime?
  sentAt    DateTime?

  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])

  @@index([status, sentAt])
}
